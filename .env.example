# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional security token for API & WebSocket (if left empty or running in UI, safe dev defaults apply)
ACCESS_TOKEN=""

# RPC Node (e.g. Ethereum Mainnet, Arbitrum, Base, Polygon). If empty, built-in reliable public RPC / Paper trading is used.
RPC_URL=""

# Dedicated private key for on-chain automated transactions (Optional: if empty, app operates in High-Precision Simulator / Paper Trading Mode, or connects to Web3 browser wallet)
BOT_PRIVATE_KEY=""

# Uniswap V3 Contract Addresses (Defaults to Ethereum Mainnet WETH/USDC)
ROUTER="0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45"
QUOTER="0x61fFE014bA17989E743c5F6cB21bF9697530B21e"
BASE_TOKEN="0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2"
QUOTE_TOKEN="0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"

# Autopilot Strategy Defaults
FEE="3000"
SIZE="50"
SLIPPAGE="0.5"
EVERY="10"
MODE="rules"
THR="0.3"
TP="1.5"
SL="1.0"
CONF="0.7"
APPROVE="exact"
AI_EVERY="30"

